# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI).
# If your Supabase project was deleted, create a new one, paste its URI here (and in Render's
# env vars for production), then either redeploy (prisma migrate deploy runs automatically) or
# run server/prisma/setup.sql manually in the Supabase SQL editor. See that file for details.
DATABASE_URL="postgresql://postgres:password@localhost:5432/aims_dev"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5001
NODE_ENV=development

# Google Gemini API key - required for AI-powered insights/forecasting.
# Without it, the API falls back to deterministic statistical analysis.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
